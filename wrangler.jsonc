{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaportrail-reference",
  "main": "dist/workerd/worker/index.js",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ]
}
